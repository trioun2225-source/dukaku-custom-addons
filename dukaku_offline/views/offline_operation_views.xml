<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Minimal support/diagnostic visibility (Stage 8 - not a dashboard):
         enough to answer "why didn't operation X sync" without exposing
         payload contents by default. groups="base.group_system" mirrors
         the ACL - Settings/technical admins only, since dukaku_offline has
         no security-group hierarchy of its own to reuse. -->
    <record id="view_dukaku_offline_operation_list" model="ir.ui.view">
        <field name="name">dukaku.offline.operation.list</field>
        <field name="model">dukaku.offline.operation</field>
        <field name="arch" type="xml">
            <list string="Offline Operations" default_order="received_at desc">
                <field name="operation_uid"/>
                <field name="submitted_by_user_id"/>
                <field name="device_uid"/>
                <field name="operation_type"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'accepted'"
                       decoration-danger="status == 'rejected'"
                       decoration-muted="status == 'pending'"/>
                <field name="received_at"/>
                <field name="processed_at"/>
                <field name="reason_code"/>
            </list>
        </field>
    </record>

    <record id="view_dukaku_offline_operation_form" model="ir.ui.view">
        <field name="name">dukaku.offline.operation.form</field>
        <field name="model">dukaku.offline.operation</field>
        <field name="arch" type="xml">
            <form string="Offline Operation">
                <sheet>
                    <group>
                        <group>
                            <field name="operation_uid"/>
                            <field name="device_uid"/>
                            <field name="client_seq"/>
                            <field name="operation_type"/>
                            <field name="submitted_by_user_id"/>
                            <field name="submission_company_id"/>
                        </group>
                        <group>
                            <field name="status"/>
                            <field name="reason_code"/>
                            <field name="reason_message"/>
                            <field name="occurred_at_client"/>
                            <field name="received_at"/>
                            <field name="processed_at"/>
                            <field name="retry_count"/>
                            <field name="last_error"/>
                        </group>
                    </group>
                    <group string="Payload / Result">
                        <field name="payload"/>
                        <field name="result_payload"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dukaku_offline_operation_search" model="ir.ui.view">
        <field name="name">dukaku.offline.operation.search</field>
        <field name="model">dukaku.offline.operation</field>
        <field name="arch" type="xml">
            <search string="Offline Operations">
                <field name="operation_uid"/>
                <field name="device_uid"/>
                <field name="submitted_by_user_id"/>
                <field name="operation_type"/>
                <filter name="filter_pending" string="Pending" domain="[('status', '=', 'pending')]"/>
                <filter name="filter_accepted" string="Accepted" domain="[('status', '=', 'accepted')]"/>
                <filter name="filter_rejected" string="Rejected" domain="[('status', '=', 'rejected')]"/>
                <filter name="filter_needs_attention" string="Needs Attention (retried)"
                        domain="[('status', '=', 'pending'), ('retry_count', '&gt;', 0)]"/>
                <group name="groupby">
                    <filter name="group_by_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_by_type" string="Operation Type" context="{'group_by': 'operation_type'}"/>
                    <filter name="group_by_device" string="Device" context="{'group_by': 'device_uid'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dukaku_offline_operation" model="ir.actions.act_window">
        <field name="name">Offline Operations</field>
        <field name="res_model">dukaku.offline.operation</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dukaku_offline_root" name="Offline Sync"
              groups="base.group_system" sequence="90"/>
    <menuitem id="menu_dukaku_offline_operation" name="Operations"
              parent="menu_dukaku_offline_root" action="action_dukaku_offline_operation" sequence="10"/>
</odoo>
