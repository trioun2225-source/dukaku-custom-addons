<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Security Category -->
    <record id="module_category_dry_cleaning" model="ir.module.category">
        <field name="name">Dukaku Dry Cleaning</field>
        <field name="description">Access rights for the Dukaku Dry Cleaning POS module.</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_dry_cleaning" model="res.groups.privilege">
        <field name="name">Dukaku Dry Cleaning</field>
        <field name="category_id" ref="module_category_dry_cleaning"/>
    </record>

    <!-- Groups -->
    <record id="group_dry_cleaning_user" model="res.groups">
        <field name="name">User</field>
        <field name="privilege_id" ref="res_groups_privilege_dry_cleaning"/>
        <field name="comment">
            Dry Cleaning Users can create and manage their own orders,
            process POS transactions, and view customer records.
        </field>
    </record>

    <!-- Capability groups: each implies the base User group only. Stage 5
         hybrid model - these compose independently of job title so a
         single-employee shop can hold all three, while a larger shop can
         split them across employees. None of these imply Manager. -->
    <record id="group_dry_cleaning_can_process" model="res.groups">
        <field name="name">Can Process</field>
        <field name="privilege_id" ref="res_groups_privilege_dry_cleaning"/>
        <field name="implied_ids" eval="[(4, ref('group_dry_cleaning_user'))]"/>
        <field name="comment">
            Can start processing and mark tickets ready.
        </field>
    </record>

    <record id="group_dry_cleaning_can_pickup" model="res.groups">
        <field name="name">Can Pickup</field>
        <field name="privilege_id" ref="res_groups_privilege_dry_cleaning"/>
        <field name="implied_ids" eval="[(4, ref('group_dry_cleaning_user'))]"/>
        <field name="comment">
            Can confirm garment pickup.
        </field>
    </record>

    <record id="group_dry_cleaning_can_reprint" model="res.groups">
        <field name="name">Can Reprint</field>
        <field name="privilege_id" ref="res_groups_privilege_dry_cleaning"/>
        <field name="implied_ids" eval="[(4, ref('group_dry_cleaning_user'))]"/>
        <field name="comment">
            Can reprint an already-printed garment label.
        </field>
    </record>

    <record id="group_dry_cleaning_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_dry_cleaning"/>
        <field name="implied_ids" eval="[
            (4, ref('group_dry_cleaning_user')),
            (4, ref('group_dry_cleaning_can_process')),
            (4, ref('group_dry_cleaning_can_pickup')),
            (4, ref('group_dry_cleaning_can_reprint')),
        ]"/>
        <field name="comment">
            Dry Cleaning Managers have full operational access to all
            dry-cleaning workflow actions, within their allowed companies.
            This does not grant broader Odoo administration (product
            configuration remains under standard Odoo product-access
            groups; see product_views.xml).
        </field>
    </record>

    <record id="base.group_system" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_dry_cleaning_manager'))]"/>
    </record>

    <!-- Multi-company record rules -->
    <data noupdate="1">

    <record id="rule_dry_cleaning_ticket_multi_company" model="ir.rule">
        <field name="name">Dry Cleaning Ticket multi-company</field>
        <field name="model_id" ref="model_dry_cleaning_ticket"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dry_cleaning_garment_tag_multi_company" model="ir.rule">
        <field name="name">Dry Cleaning Garment Tag multi-company</field>
        <field name="model_id" ref="model_dry_cleaning_garment_tag"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_dry_cleaning_event_multi_company" model="ir.rule">
        <field name="name">Dry Cleaning Event multi-company</field>
        <field name="model_id" ref="model_dry_cleaning_event"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    </data>

</odoo>
