<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Expose requires_garment_tag in the same "Point of Sale" tab that
         point_of_sale itself adds to the product form, next to the other
         POS-specific toggles. -->
    <record id="view_product_template_form_garment_tag" model="ir.ui.view">
        <field name="name">product.template.form.dry.cleaning.garment.tag</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="point_of_sale.product_template_form_view"/>
        <field name="arch" type="xml">
            <group name="pos" position="inside">
                <field name="requires_garment_tag"/>
            </group>
        </field>
    </record>
</odoo>
