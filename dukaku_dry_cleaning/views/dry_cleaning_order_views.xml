<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dry_cleaning_order_tree" model="ir.ui.view">
        <field name="name">dry.cleaning.order.list</field>
        <field name="model">dry.cleaning.order</field>
        <field name="arch" type="xml">
            <list string="Dry Cleaning Orders" decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'delivered'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="date_order"/>
                <field name="date_expected"/>
                <field name="amount_total" sum="Total"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state in ('confirmed','in_progress')"
                       decoration-success="state in ('ready','delivered')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_dry_cleaning_order_form" model="ir.ui.view">
        <field name="name">dry.cleaning.order.form</field>
        <field name="model">dry.cleaning.order</field>
        <field name="arch" type="xml">
            <form string="Dry Cleaning Order">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                            class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_start" string="Start Processing" type="object"
                            class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_ready" string="Mark Ready" type="object"
                            class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_deliver" string="Deliver / Pick Up" type="object"
                            class="oe_highlight" invisible="state != 'ready'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state in ('delivered', 'cancelled')"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed,in_progress,ready,delivered"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="barcode"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="date_order"/>
                            <field name="date_expected"/>
                            <field name="date_ready" invisible="not date_ready"/>
                            <field name="date_delivered" invisible="not date_delivered"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Garments">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="service_type_id"/>
                                    <field name="garment_description"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="notes"/>
                                    <field name="subtotal" sum="Total"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="amount_total"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_dry_cleaning_order_search" model="ir.ui.view">
        <field name="name">dry.cleaning.order.search</field>
        <field name="model">dry.cleaning.order</field>
        <field name="arch" type="xml">
            <search string="Search Dry Cleaning Orders">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="barcode"/>
                <filter string="Draft" name="filter_draft" domain="[('state','=','draft')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('state','=','in_progress')]"/>
                <filter string="Ready" name="filter_ready" domain="[('state','=','ready')]"/>
                <separator/>
                <filter string="My Orders" name="filter_mine" domain="[('create_uid','=',uid)]"/>
                <group>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Customer" name="group_partner" context="{'group_by': 'partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_dry_cleaning_order" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">dry.cleaning.order</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_draft': 0}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smart_action">Create your first dry cleaning order</p>
        </field>
    </record>

    <!-- Wires the action into the existing "Orders" menu entry created in
         dry_cleaning_menus.xml (same external id, so this only adds the action
         to it rather than duplicating the menu). -->
    <menuitem id="menu_dry_cleaning_orders_root" action="action_dry_cleaning_order"/>

</odoo>
