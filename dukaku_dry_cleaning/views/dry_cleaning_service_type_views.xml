<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_dry_cleaning_service_type_tree" model="ir.ui.view">
        <field name="name">dry.cleaning.service.type.tree</field>
        <field name="model">dry.cleaning.service.type</field>
        <field name="arch" type="xml">
            <list string="Service Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="default_price"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_dry_cleaning_service_type_form" model="ir.ui.view">
        <field name="name">dry.cleaning.service.type.form</field>
        <field name="model">dry.cleaning.service.type</field>
        <field name="arch" type="xml">
            <form string="Service Type">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object"
                                class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button"
                                   options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="default_price"/>
                        <field name="currency_id" groups="base.group_multi_currency"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dry_cleaning_service_type" model="ir.actions.act_window">
        <field name="name">Service Types</field>
        <field name="res_model">dry.cleaning.service.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_dry_cleaning_service_types"
              name="Service Types"
              parent="menu_dry_cleaning_configuration_root"
              action="action_dry_cleaning_service_type"
              sequence="10"/>

</odoo>
