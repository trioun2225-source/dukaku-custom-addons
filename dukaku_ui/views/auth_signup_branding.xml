<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Replace the "Powered by Odoo" link with plain "Dukaku POS" text
             on the password reset email. Surgical xpath override (not a full
             body copy) since this one is a real QWeb view and supports it. -->
        <template id="reset_password_email_footer" inherit_id="auth_signup.reset_password_email">
            <xpath expr="//a[contains(@href,'odoo.com')]" position="replace"><span>Dukaku POS</span></xpath>
        </template>

        <!-- The 3 sibling auth_signup mail.template records (invite/welcome/
             portal-invite emails) are NOT QWeb views - they're mail.template
             records with an html field, and auth_signup's own data file wraps
             them in noupdate="1". A <record> re-declaration referencing the
             same external id is silently skipped on module *update* (only
             applies on a genuinely fresh install) per odoo/orm/models.py
             _load_records(): "if not (update and d_noupdate): to_update...".
             So these are patched via _rebrand_auth_signup_emails() in
             hooks.py instead - a plain ORM write, which isn't subject to
             that noupdate gate - called from post_init_hook (fresh installs)
             and re-run manually whenever dukaku_ui is updated on an
             already-installed database. -->

    </data>
</odoo>
